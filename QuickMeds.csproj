<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>QuickMeds</RootNamespace>
    <AssemblyName>QuickMeds</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <FileVersion>1.2.0</FileVersion>
    <Version>1.2.0</Version>
    <Deterministic>true</Deterministic>
    <Title>BlackHawk-QuickMeds</Title>
    <Product>BlackHawk-QuickMeds</Product>
    <Description>Movement-friendly healing with local-player-safe adaptive timing and auto-cancel.</Description>
    <Copyright>Copyright (c) BLACK HAWK. MIT licensed.</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedPath>$(SptPath)\EscapeFromTarkov_Data\Managed</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the MIT notice inside the binary so the runtime ZIP can stay DLL-only. -->
    <EmbeddedResource Include="LICENSE" LogicalName="QuickMeds.LICENSE.txt" />
  </ItemGroup>

  <Target Name="RequireSptPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SptPath)' == ''" Text="SptPath is required. Use build.ps1 or dotnet build -p:SptPath=&quot;C:\Path\To\SPT&quot;." />
    <Error Condition="!Exists('$(SptPath)\EscapeFromTarkov.exe')" Text="SptPath does not point to an SPT root containing EscapeFromTarkov.exe." />
    <Error Condition="!Exists('$(ManagedPath)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found under $(ManagedPath)." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(SptPath)\BepInEx\core\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptPath)\BepInEx\core\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="spt-common"><HintPath>$(SptPath)\BepInEx\plugins\spt\spt-common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptPath)\BepInEx\plugins\spt\spt-reflection.dll</HintPath><Private>False</Private></Reference>

    <Reference Include="AnimationSystem.Types"><HintPath>$(ManagedPath)\AnimationSystem.Types.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ItemComponent.Types"><HintPath>$(ManagedPath)\ItemComponent.Types.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(ManagedPath)\Comfort.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Comfort.Unity"><HintPath>$(ManagedPath)\Comfort.Unity.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="CommonExtensions"><HintPath>$(ManagedPath)\CommonExtensions.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(ManagedPath)\Sirenix.Serialization.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes"><HintPath>$(ManagedPath)\Sirenix.OdinInspector.Attributes.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedPath)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>